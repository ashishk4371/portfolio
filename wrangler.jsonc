{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/portfolio/browser",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "byashish.dev", "custom_domain": true },
    { "pattern": "www.byashish.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
